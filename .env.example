# GEMINI_API_KEY: Required for Gemini AI API calls and grounded flood intelligence.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database & Cache Configurations
DATABASE_URL="postgresql://pehra_admin:password@localhost:5432/pehra_postgis"
REDIS_URL="redis://localhost:6379/0"

# Authentication Secrets
JWT_SECRET="pehra-production-jwt-signing-secret-key-32chars"
JWT_REFRESH_SECRET="pehra-production-jwt-refresh-signing-key-32chars"

# External Disaster Data Providers
MUMBAI_FLOOD_API_URL="https://mumbaiflood.in/api/v1"
MUMBAI_FLOOD_API_KEY=""

WEATHER_API_URL="https://api.imd.gov.in/v1"
WEATHER_API_KEY=""

# Alert Delivery Providers
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
SMS_PROVIDER_URL="https://api.sms-gateway.gov.in/v2"
SMS_PROVIDER_KEY=""

# Mapping Providers
MAP_PROVIDER_KEY=""

